{
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python.defaultInterpreterPath": "${workspaceFolder}/hf-text-to-speech/.venv/bin/python",
  "pylint.interpreter": [
    "${workspaceFolder}/hf-text-to-speech/.venv/bin/python"
  ],
  "pylint.args": [
    "--init-hook=import sys; from pathlib import Path; root=Path('${workspaceFolder}'); [sys.path.insert(0, str(p)) for p in sorted(root.glob('*/.venv/lib/python*/site-packages'))]"
  ],
  "cursorpyright.analysis.extraPaths": [
    "${workspaceFolder}/hf-text-to-speech/.venv/lib/python3.12/site-packages",
    "${workspaceFolder}/mflux-text-to-image/.venv/lib/python3.12/site-packages",
    "${workspaceFolder}/rembg-background-removal/.venv/lib/python3.12/site-packages"
  ]
}
